#!/usr/bin/env bash
set -euo pipefail

message_file="${1:?commit-msg hook requires the commit message file}"

if [[ ! -f "$message_file" ]]; then
  echo "Commit rejected: commit message file not found." >&2
  exit 1
fi

# Inspect Git trailer lines only. Match common AI products, agents, bot
# markers, and automated noreply identities without rejecting ordinary
# mentions of AI in the commit subject or body.
pattern='^[[:space:]]*Co-authored-by:[[:space:]]*.*([[:<:]](bot|ai|agent|assistant|copilot|claude|chatgpt|openai|codex|cursor|gemini|devin|swe-agent)[[:>:]]|\[bot\]|noreply\+.*\[bot\])'

if grep -Eiq "$pattern" "$message_file"; then
  echo "Commit rejected: AI tools, agents, and bots must not be Git co-authors." >&2
  echo "Remove the automated Co-authored-by trailer. Human co-authors are permitted." >&2
  exit 1
fi

exit 0
